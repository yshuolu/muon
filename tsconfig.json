{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "skipLibCheck": true, "esModuleInterop": true,
    "resolveJsonModule": true, "allowImportingTsExtensions": true, "noEmit": true,
    "types": ["node", "vite/client"], "baseUrl": ".", "paths": { "@/*": ["src/web/*"] }
  },
  "include": ["src", "scripts", "vite.config.ts", "vitest.config.ts"]
}
